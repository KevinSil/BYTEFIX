@model IEnumerable<Intervencao>
@{
    ViewData["Title"] = "Intervenções";
    ViewData["Section"] = "Intervenções";
}

<div class="page-header page-heading">
    <div>
        <div class="page-eyebrow">GESTÃO</div>
        <h1>Intervenções</h1>
        <p>Registo do trabalho executado em cada reparação.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Nova intervenção</a>
</div>

<div class="card table-card">
    <div class="table-responsive table-wrapper">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th>Reparação</th>
                    <th>Data</th>
                    <th>Tempo</th>
                    <th>Mão de obra</th>
                    <th>Peças</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Ainda não existem intervenções registadas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var intervencao in Model)
                    {
                        <tr>
                            <td>@intervencao.Reparacao?.Equipamento?.Marca @intervencao.Reparacao?.Equipamento?.Modelo</td>
                            <td>@intervencao.DataIntervencao.ToString("dd/MM/yyyy")</td>
                            <td>@intervencao.TempoTrabalho.ToString("0.##") h</td>
                            <td>@intervencao.CustoMaoObra.ToString("C2")</td>
                            <td>@intervencao.CustoPecas.ToString("C2")</td>
                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Edit" asp-route-id="@intervencao.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit me-1"></i>Editar</a>
                                    <a asp-action="Delete" asp-route-id="@intervencao.Id" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash me-1"></i>Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
