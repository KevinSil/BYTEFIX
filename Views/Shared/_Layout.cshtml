<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ByteFix</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.7.4/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.34.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <div class="page app-shell">
        <aside class="navbar navbar-vertical navbar-expand-lg app-sidebar" id="app-sidebar" data-bs-theme="light">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="ti ti-tool"></i></span>
                <span>
                    <strong>ByteFix</strong>
                    
                </span>
            </a>

            <div class="sidebar-label">GESTÃO</div>
            <nav class="navbar-nav sidebar-nav" aria-label="Navegação principal">
                <a class="nav-link sidebar-link @(currentController == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" ? "page" : null)">
                    <i class="ti ti-layout-dashboard"></i>
                    <span>Dashboard</span>
                </a>
                <a class="nav-link sidebar-link @(currentController == "Clientes" ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                    <i class="ti ti-users"></i>
                    <span>Clientes</span>
                </a>
                <a class="nav-link sidebar-link @(currentController == "Equipamentos" ? "active" : "")" asp-controller="Equipamentos" asp-action="Index">
                    <i class="ti ti-device-laptop"></i>
                    <span>Equipamentos</span>
                </a>
                <a class="nav-link sidebar-link @(currentController == "Tecnicos" ? "active" : "")" asp-controller="Tecnicos" asp-action="Index">
                    <i class="ti ti-user-cog"></i>
                    <span>Técnicos</span>
                </a>
                <a class="nav-link sidebar-link @(currentController == "Reparacoes" ? "active" : "")" asp-controller="Reparacoes" asp-action="Index">
                    <i class="ti ti-tool"></i>
                    <span>Reparações</span>
                </a>
                <a class="nav-link sidebar-link @(currentController == "Intervencoes" ? "active" : "")" asp-controller="Intervencoes" asp-action="Index">
                    <i class="ti ti-clipboard-list"></i>
                    <span>Intervenções</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span>Base SQLite configurada</span>
            </div>
        </aside>

        <div class="page-wrapper app-main">
            <header class="navbar navbar-expand-md topbar">
                <button class="btn btn-ghost-secondary sidebar-toggle" type="button"
                        aria-label="Abrir navegação" aria-controls="app-sidebar" aria-expanded="false">
                    <i class="ti ti-menu-2"></i>
                </button>
                <div class="topbar-title">
                    <span class="text-secondary">ByteFix</span>
                    <i class="ti ti-chevron-right" aria-hidden="true"></i>
                    <span>@ViewData["Section"]</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2 text-secondary small">
                    <span class="status-dot"></span>
                    <span>Sistema operacional</span>
                </div>
            </header>

            <main class="page-body page-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                <span>ByteFix <span aria-hidden="true">&middot;</span></span>
                <span>Estrutura inicial do sistema</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.7.4/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
