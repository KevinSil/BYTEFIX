<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ByteFix</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.34.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="ti ti-tool"></i></span>
                <span>
                    <strong>ByteFix</strong>
                    <small>Smart Repair Management</small>
                </span>
            </a>

            <div class="sidebar-label">GESTÃO</div>
            <nav class="sidebar-nav" aria-label="Navegação principal">
                <a class="sidebar-link active" asp-controller="Home" asp-action="Index" aria-current="page">
                    <i class="ti ti-layout-dashboard"></i>
                    <span>Dashboard</span>
                </a>
                <a class="sidebar-link" asp-controller="Clientes" asp-action="Index">
                    <i class="ti ti-users"></i>
                    <span>Clientes</span>
                </a>
                <a class="sidebar-link" asp-controller="Equipamentos" asp-action="Index">
                    <i class="ti ti-device-laptop"></i>
                    <span>Equipamentos</span>
                </a>
                <a class="sidebar-link" asp-controller="Tecnicos" asp-action="Index">
                    <i class="ti ti-user-cog"></i>
                    <span>Técnicos</span>
                </a>
                <a class="sidebar-link" asp-controller="Reparacoes" asp-action="Index">
                    <i class="ti ti-tool"></i>
                    <span>Reparações</span>
                </a>
                <a class="sidebar-link" asp-controller="Intervencoes" asp-action="Index">
                    <i class="ti ti-clipboard-list"></i>
                    <span>Intervenções</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span>Base SQLite configurada</span>
            </div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="btn btn-ghost-secondary sidebar-toggle" type="button"
                        aria-label="Abrir navegação" aria-controls="app-sidebar" aria-expanded="false">
                    <i class="ti ti-menu-2"></i>
                </button>
                <div class="topbar-title">@ViewData["Section"]</div>
                <div class="topbar-search">
                    <i class="ti ti-search"></i>
                    <input class="form-control" type="search" placeholder="Pesquisa disponível na Fase 2"
                           aria-label="Pesquisa" disabled />
                </div>
                <span class="phase-badge">FASE 1</span>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                <span>ByteFix <span aria-hidden="true">&middot;</span> Smart Repair Management</span>
                <span>Estrutura inicial do sistema</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
