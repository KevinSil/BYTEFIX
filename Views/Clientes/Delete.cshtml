@model Cliente
@{
    ViewData["Title"] = "Eliminar cliente";
    ViewData["Section"] = "Clientes";
}

<div class="page-heading">
    <div>
        <div class="page-eyebrow">CLIENTES</div>
        <h1>Eliminar cliente</h1>
    </div>
</div>

<div class="form-card">
    <p>Tem a certeza que pretende eliminar o cliente <strong>@Model.Nome</strong>?</p>
    <dl class="row mb-4">
        <dt class="col-sm-3">NIF</dt>
        <dd class="col-sm-9">@Model.NIF</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Telefone</dt>
        <dd class="col-sm-9">@Model.Telefone</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
