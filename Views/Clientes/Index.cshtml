@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
    ViewData["Section"] = "Clientes";
}

<div class="page-header page-heading">
    <div>
        <div class="page-eyebrow">GESTÃO</div>
        <h1>Clientes</h1>
        <p>Consulta e manutenção dos clientes da empresa.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Novo cliente</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card table-card">
    <div class="table-responsive table-wrapper">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>NIF</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Localidade</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Ainda não existem clientes registados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td>@cliente.Nome</td>
                            <td>@cliente.NIF</td>
                            <td>@cliente.Email</td>
                            <td>@cliente.Telefone</td>
                            <td>@cliente.Localidade</td>
                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit me-1"></i>Editar</a>
                                    <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash me-1"></i>Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
