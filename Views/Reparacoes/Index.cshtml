@model IEnumerable<Reparacao>
@{
    ViewData["Title"] = "Reparações";
    ViewData["Section"] = "Reparações";
}

<div class="page-header page-heading">
    <div>
        <div class="page-eyebrow">GESTÃO</div>
        <h1>Reparações</h1>
        <p>Acompanhamento do estado das intervenções em curso.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Nova reparação</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card table-card">
    <div class="table-responsive table-wrapper">
        <table class="table table-vcenter table-hover card-table">
            <thead>
                <tr>
                    <th>Equipamento</th>
                    <th>Técnico</th>
                    <th>Estado</th>
                    <th>Data entrada</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Ainda não existem reparações registadas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var reparacao in Model)
                    {
                        <tr>
                            <td>@reparacao.Equipamento?.Marca @reparacao.Equipamento?.Modelo</td>
                            <td>@reparacao.Tecnico?.Nome</td>
                            <td>
                                <span class="badge bg-info text-dark">@reparacao.Estado</span>
                            </td>
                            <td>@reparacao.DataEntrada.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="action-group">
                                    <a asp-action="Edit" asp-route-id="@reparacao.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit me-1"></i>Editar</a>
                                    <a asp-action="Delete" asp-route-id="@reparacao.Id" class="btn btn-sm btn-outline-danger"><i class="ti ti-trash me-1"></i>Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
